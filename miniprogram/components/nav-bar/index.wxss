.nav {
  position: sticky;
  top: 0;
  z-index: 20;
  width: 100%;
  background: linear-gradient(180deg, rgba(5, 8, 17, 0.92), rgba(5, 8, 17, 0.55) 72%, transparent);
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 30rpx;
  padding-right: 190rpx;
}

.nav-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-right: 12rpx;
  border: 1rpx solid rgba(198, 205, 223, 0.16);
  border-radius: 50%;
  color: #c8c1b4;
  font-family: Georgia, serif;
  font-size: 40rpx;
  line-height: 1;
}

.nav-brand {
  display: flex;
  align-items: center;
  min-width: 0;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 13rpx;
  border: 1rpx solid rgba(215, 198, 164, 0.32);
  border-radius: 50%;
  color: #d9c39a;
  font-size: 20rpx;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.brand-cn {
  color: #e1d6c4;
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
  font-size: 27rpx;
  line-height: 1.15;
  letter-spacing: 2rpx;
}

.brand-en {
  margin-top: 5rpx;
  color: #6f7786;
  font-size: 13rpx;
  line-height: 1;
  letter-spacing: 2rpx;
}

.nav-page {
  flex: 0 0 auto;
  overflow: hidden;
  color: #737b89;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
