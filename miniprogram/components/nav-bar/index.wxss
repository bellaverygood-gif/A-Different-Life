.nav {
  position: sticky;
  top: 0;
  z-index: 20;
  width: 100%;
  background: transparent;
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-left: 24rpx;
  padding: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
}
.nav-left { display: flex; align-items: center; min-width: 0; }
.nav-back {
  display: flex; align-items: center; justify-content: center;
  width: 52rpx; height: 52rpx; margin-right: 10rpx;
  border: 0; background: transparent;
  color: #f2ecdf; font-family: Georgia, serif; font-size: 40rpx; line-height: 1;
}
.nav-brand { display: flex; align-items: center; min-width: 0; }
.brand-logo {
  display: block;
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
  border: 0;
  border-radius: 13rpx;
  background: transparent;
}
.brand-copy { display: flex; flex-direction: column; min-width: 0; }
.brand-cn {
  color: #f2ecdf;
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
  font-size: 26rpx; line-height: 1.15; letter-spacing: 2rpx;
}
.brand-en { display: none; }
.nav-page { display: none; }
