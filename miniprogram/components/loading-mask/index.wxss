.loading-mask {
  position: fixed;
  z-index: 99;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 44%, rgba(132, 96, 49, 0.12), transparent 25%),
    rgba(3, 6, 13, 0.94);
}

.loading-orb {
  position: relative;
  width: 190rpx;
  height: 190rpx;
  animation: breathe 2.4s ease-in-out infinite;
}

.orb-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 280rpx;
  height: 100rpx;
  border: 1rpx solid rgba(221, 190, 137, 0.25);
  border-radius: 50%;
  transform: translate(-50%, -50%) rotate(-18deg);
}

.ring-two {
  width: 330rpx;
  height: 120rpx;
  transform: translate(-50%, -50%) rotate(30deg);
  opacity: 0.55;
}

.orb-core {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 138rpx;
  height: 138rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 28%, #fff4d1, #dfb77c 24%, #8e5f2d 58%, #21150c 100%);
  color: rgba(44, 30, 15, 0.78);
  font-family: "Songti SC", Georgia, serif;
  font-size: 58rpx;
  box-shadow: 0 0 70rpx rgba(217, 176, 109, 0.2);
  transform: translate(-50%, -50%);
}

.loading-title {
  margin-top: 55rpx;
  color: #d7cbbb;
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.loading-sub {
  margin-top: 12rpx;
  color: #6f7786;
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

@keyframes breathe {
  0%, 100% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.04); opacity: 1; }
}
