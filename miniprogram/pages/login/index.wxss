.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #050811;
}

.login-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.58;
}

.login-veil {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(5, 8, 17, 0.94) 0%, rgba(5, 8, 17, 0.72) 52%, rgba(5, 8, 17, 0.36) 100%),
    linear-gradient(180deg, rgba(5, 8, 17, 0.22) 0%, rgba(5, 8, 17, 0.52) 56%, #050811 100%);
}

.login-glow {
  position: absolute;
  top: 18%;
  right: -30%;
  width: 620rpx;
  height: 620rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(150, 125, 190, 0.25), transparent 66%);
  filter: blur(18rpx);
}

.login-inner {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 18rpx 36rpx calc(42rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding-top: 18rpx;
}

.login-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border: 1rpx solid rgba(215, 198, 164, 0.32);
  border-radius: 50%;
  color: #d9c39a;
  font-size: 20rpx;
}

.login-brand-copy {
  display: flex;
  flex-direction: column;
}

.login-brand-cn {
  color: #e1d6c4;
  font-size: 27rpx;
  letter-spacing: 2rpx;
  line-height: 1.15;
}

.login-brand-en {
  margin-top: 4rpx;
  color: #6f7786;
  font-size: 13rpx;
  letter-spacing: 3rpx;
}

.login-main {
  flex: 1;
  padding-top: 19vh;
}

.login-title {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  color: #f0e9dd;
  font-size: 58rpx;
  line-height: 1.32;
  letter-spacing: -2rpx;
  text-shadow: 0 4rpx 30rpx rgba(0, 0, 0, 0.4);
}

.login-title text {
  display: block;
}

.login-lede {
  display: block;
  max-width: 590rpx;
  margin-top: 25rpx;
  color: #a6a7a5;
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
  font-size: 24rpx;
  line-height: 1.9;
}

.login-bottom {
  padding-top: 32rpx;
}

.login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 94rpx;
  padding: 0;
  border: 1rpx solid rgba(226, 197, 146, 0.5);
  border-radius: 999rpx;
  background: linear-gradient(135deg, #e2c58f, #c9a66e);
  color: #1d160d;
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
  font-size: 28rpx;
  line-height: 1;
  letter-spacing: 3rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(197, 164, 108, 0.16);
}

.login-button::after {
  border: none;
}

.login-button[disabled] {
  opacity: 0.66;
}

.login-hint {
  display: block;
  margin-top: 14rpx;
  color: #747c88;
  font-size: 17rpx;
  text-align: center;
}

.login-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
}

.login-compliance {
  flex: 1;
  color: #5f6875;
  font-size: 15rpx;
  line-height: 1.6;
}

.login-privacy {
  flex: 0 0 auto;
  color: #8f7d63;
  font-size: 16rpx;
  text-decoration: underline;
  text-underline-offset: 5rpx;
}
