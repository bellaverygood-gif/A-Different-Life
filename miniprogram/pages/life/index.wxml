<view class="page life-page">
  <nav-bar title="抽一个人生" />

  <block wx:if="{{view === 'setup'}}">
    <view class="life-setup">
      <image class="life-cover" src="/assets/mode-blind.jpg" mode="aspectFill" />
      <view class="life-setup-mark">◉</view>
      <text class="eyebrow">抽一个人生 · {{livesCount}} 段虚构人生</text>
      <view class="life-setup-title serif">
        <text>抽一个人生，</text>
        <text class="gold">从出生读到后来。</text>
      </view>
      <text class="life-setup-copy">不是预测，也不评判任何人的选择。只是一个陌生人的一段人生，恰好被你打开。</text>

      <view class="life-setup-action">
        <view class="btn btn-primary" bindtap="drawLife">抽盲盒人生 <text>✦</text></view>
        <text wx:if="{{lastLifeName}}" class="life-last">上次读到：{{lastLifeName}}</text>
        <text wx:else class="life-last">一个人生里，是几个可以慢慢读的阶段。</text>
      </view>

      <view class="life-setup-notes">
        <view class="life-note-row">
          <text class="life-note-k">读什么</text>
          <text class="life-note-v">来自、家庭经济、营生类型、几个阶段</text>
        </view>
        <view class="life-note-row">
          <text class="life-note-k">怎么读</text>
          <text class="life-note-v">没有分支，也不需要你选择结局</text>
        </view>
        <view class="life-note-row">
          <text class="life-note-k">本机记录</text>
          <text class="life-note-v">{{historyCount}} / 20</text>
        </view>
      </view>

      <view wx:if="{{history.length}}" class="life-history">
        <text class="eyebrow">最近读过</text>
        <view
          wx:for="{{history}}"
          wx:key="id"
          class="life-history-row"
          data-id="{{item.id}}"
          bindtap="openHistory"
        >
          <view class="life-history-main">
            <text class="life-history-name">{{item.name}}</text>
            <text class="life-history-meta">{{item.province}} · {{item.dateLabel}}</text>
          </view>
          <text class="life-history-emotion">{{item.emotionLabel}}</text>
        </view>
      </view>

      <text class="life-disclaimer">本产品提供虚构叙事与自我反思内容，不构成心理咨询、医疗、法律、投资或其他专业建议。</text>
    </view>
  </block>

  <block wx:if="{{view === 'result' && life}}">
    <view class="life-result-hero">
      <image class="life-hero-img" src="/assets/mode-blind.jpg" mode="aspectFill" />
      <view class="life-hero-shade"></view>
      <view class="life-hero-inner">
        <text class="eyebrow">抽一个人生 · 已打开</text>
        <view class="life-result-meta">
          <text>{{life.province}}</text>
          <text>{{life.gender}}</text>
        </view>
        <text class="life-name serif">{{life.name}}</text>
        <text class="life-one-line">{{life.oneLine}}</text>
      </view>
    </view>

    <view class="life-body shell">
      <view class="life-section">
        <image class="life-deco" src="/assets/story-camera.jpg" mode="aspectFill" />
        <text class="eyebrow">骨架</text>
        <text class="life-section-title serif">这一段人生的起点</text>
        <view class="life-skeleton">
          <view wx:for="{{life.skeleton}}" wx:key="label" class="life-skeleton-row">
            <text class="life-skeleton-label">{{item.label}}</text>
            <text class="life-skeleton-value">{{item.value}}</text>
          </view>
        </view>
      </view>

      <view class="life-section">
        <image class="life-deco" src="/assets/story-love.jpg" mode="aspectFill" />
        <text class="eyebrow">逐段阅读</text>
        <text class="life-section-title serif">从早年，到后来</text>
        <view class="life-fragments">
          <view wx:for="{{life.fragments}}" wx:key="key" class="life-fragment">
            <text class="life-fragment-stage">{{item.stage}}</text>
            <text class="life-fragment-text">{{item.text}}</text>
          </view>
        </view>
      </view>

      <view class="life-section life-landing">
        <image class="life-deco" src="/assets/story-career.jpg" mode="aspectFill" />
        <text class="eyebrow">一句落点</text>
        <text class="life-landing-text serif">{{life.landing}}</text>
      </view>

      <view class="life-section life-emotion">
        <image class="life-deco" src="/assets/story-health.jpg" mode="aspectFill" />
        <text class="eyebrow">读完之后</text>
        <text class="life-section-title serif">这一生，让你更轻松还是更沉重？</text>
        <view class="life-emotion-row">
          <view
            wx:for="{{emotions}}"
            wx:key="key"
            class="life-emotion-btn {{emotion === item.key ? 'is-active' : ''}}"
            data-emotion="{{item.key}}"
            bindtap="setEmotion"
          >{{item.label}}</view>
        </view>
        <text class="life-emotion-note">只记在本机，用来判断内容是否让人更沉重。</text>
      </view>

      <view class="life-card-actions">
        <view class="life-card-btn" bindtap="onCardAction">{{cardPath ? '保存这一段人生的图卡' : '生成这一段人生的图卡'}}</view>
      </view>

      <view class="life-actions">
        <button class="btn btn-ghost" open-type="share">分享这一段人生</button>
        <view class="btn btn-primary" bindtap="drawAgain">再抽一个</view>
      </view>

      <view class="life-bottom">
        <text bindtap="goHome">回到首页</text>
        <text class="life-dot">·</text>
        <text bindtap="openPrivacy">隐私说明</text>
      </view>
      <text class="life-disclaimer">本产品提供虚构叙事与自我反思内容，不构成心理咨询、医疗、法律、投资或其他专业建议。</text>
    </view>
  </block>

  <canvas canvas-id="lifeCard" class="life-card-canvas"></canvas>
  <loading-mask show="{{loading}}" text="正在打开一段人生" sub="里面是几个可以慢慢读的阶段" />
</view>
