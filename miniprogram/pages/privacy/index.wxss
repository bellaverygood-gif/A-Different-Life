.privacy-page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.privacy-shell {
  padding: 28rpx 32rpx 0;
}

.privacy-hero {
  padding: 32rpx 4rpx 36rpx;
  border-bottom: 1rpx solid rgba(195, 202, 219, 0.12);
}

.privacy-title {
  display: block;
  margin-top: 17rpx;
  color: #eee5d7;
  font-size: 53rpx;
  line-height: 1.35;
  letter-spacing: -1rpx;
}

.privacy-title text {
  display: block;
}

.privacy-lede {
  display: block;
  margin-top: 18rpx;
  color: #969b9f;
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
  font-size: 24rpx;
  line-height: 1.9;
}

.privacy-updated {
  display: block;
  margin-top: 15rpx;
  color: #676f7d;
  font-size: 17rpx;
}

.privacy-section {
  padding: 34rpx 0 7rpx;
  border-bottom: 1rpx solid rgba(195, 202, 219, 0.09);
}

.privacy-index {
  display: block;
  color: #8d7655;
  font-family: Georgia, serif;
  font-size: 16rpx;
}

.privacy-heading {
  display: block;
  margin-top: 8rpx;
  color: #dcd2c3;
  font-size: 34rpx;
  line-height: 1.45;
}

.privacy-text {
  display: block;
  margin-top: 16rpx;
  color: #9fa1a3;
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
  font-size: 22rpx;
  line-height: 1.95;
}

.privacy-list {
  margin-top: 13rpx;
}

.privacy-item {
  display: flex;
  gap: 18rpx;
  padding: 15rpx 0;
  border-bottom: 1rpx solid rgba(195, 202, 219, 0.07);
}

.privacy-item text:first-child {
  flex: 0 0 120rpx;
  color: #8f816d;
  font-size: 20rpx;
}

.privacy-item text:last-child {
  flex: 1;
  color: #969da6;
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
  font-size: 21rpx;
  line-height: 1.8;
}

.privacy-callout {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  margin-top: 20rpx;
  padding: 17rpx 18rpx;
  border-left: 3rpx solid rgba(217, 186, 132, 0.45);
  background: rgba(217, 186, 132, 0.045);
}

.privacy-callout text:first-child {
  color: #b49a70;
  font-family: "Songti SC", Georgia, serif;
  font-size: 22rpx;
}

.privacy-callout text:last-child {
  color: #98928a;
  font-size: 20rpx;
  line-height: 1.8;
}

.privacy-foot {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 38rpx 2rpx 30rpx;
  color: #5f6876;
  font-size: 16rpx;
  line-height: 1.7;
}

.privacy-agreement {
  display: block;
  margin-top: 12rpx;
  color: #a99b84;
}
