.agreement-page {
  padding-bottom: calc(50rpx + env(safe-area-inset-bottom));
}

.agreement-shell {
  padding: 60rpx 34rpx 40rpx;
}

.agreement-hero {
  padding-bottom: 34rpx;
  border-bottom: 1rpx solid rgba(201, 207, 222, 0.1);
}

.agreement-title {
  margin-top: 20rpx;
  color: #f1eadf;
  font-size: 48rpx;
  line-height: 1.4;
}

.agreement-title text {
  display: block;
}

.agreement-updated {
  display: block;
  margin-top: 18rpx;
  color: #6f7683;
  font-size: 20rpx;
}

.agreement-section {
  padding: 30rpx 0;
  border-bottom: 1rpx solid rgba(201, 207, 222, 0.08);
}

.agreement-index {
  display: block;
  color: #cbb488;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.agreement-heading {
  display: block;
  margin-top: 8rpx;
  color: #e8e1d4;
  font-size: 34rpx;
}

.agreement-text {
  display: block;
  margin-top: 12rpx;
  color: #a9a7a1;
  font-size: 24rpx;
  line-height: 1.9;
}

.agreement-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 36rpx;
  color: #9a8f7e;
  font-size: 22rpx;
}
