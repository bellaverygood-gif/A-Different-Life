.auth-bridge { min-height: 100vh; background: #050811; }
.auth-shell { padding: 120rpx 36rpx 80rpx; }
.auth-card { padding: 48rpx 34rpx 36rpx; border: 1rpx solid rgba(205, 167, 109, 0.22); border-radius: 30rpx; background: linear-gradient(150deg, rgba(27, 35, 55, 0.98), rgba(8, 12, 21, 0.99)); }
.auth-kicker { display: block; color: #cbb488; font-size: 19rpx; letter-spacing: 4rpx; }
.auth-title { display: block; margin-top: 22rpx; color: #f2ecdf; font-size: 48rpx; line-height: 1.3; }
.auth-text { display: block; margin-top: 18rpx; color: #b8b0a2; font-size: 25rpx; line-height: 1.8; }
.auth-done { margin-top: 34rpx; padding: 22rpx; border: 1rpx solid rgba(205, 167, 109, 0.22); border-radius: 16rpx; color: #e3d0a9; font-size: 25rpx; }
.auth-loading { margin-top: 34rpx; color: #8e877b; font-size: 23rpx; }
.auth-actions { display: flex; gap: 16rpx; margin-top: 30rpx; }
.auth-actions .btn { flex: 1; }
.auth-note { display: block; margin-top: 30rpx; color: #6f7783; font-size: 20rpx; line-height: 1.8; }
.auth-privacy { display: inline-block; margin-top: 16rpx; color: #cbb488; font-size: 20rpx; }
