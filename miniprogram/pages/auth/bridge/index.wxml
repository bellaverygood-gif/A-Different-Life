<view class="page auth-bridge">
  <nav-bar title="微信登录" />
  <view class="auth-shell">
    <view class="auth-card">
      <text class="auth-kicker">此生之外</text>
      <text class="auth-title serif">{{status === 'success' ? '登录成功' : '微信授权登录'}}</text>
      <text class="auth-text">{{message}}</text>
      <view wx:if="{{status === 'success'}}" class="auth-done">
        <text>可以回到网页继续了。</text>
      </view>
      <view wx:elif="{{status === 'error'}}" class="auth-actions">
        <view class="btn btn-primary" bindtap="retry">重试</view>
        <view class="btn btn-ghost" bindtap="openPrivacy">隐私说明</view>
      </view>
      <view wx:else class="auth-loading">
        <text>正在获取微信登录状态…</text>
      </view>
      <text class="auth-note">只获取微信身份标识，用于本次登录。不会获取昵称、头像或手机号。</text>
      <text class="auth-privacy" bindtap="openPrivacy">隐私说明</text>
    </view>
  </view>
</view>
