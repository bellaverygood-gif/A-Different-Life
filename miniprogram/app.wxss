/* script */
.script-setup, .script-result-hero { background: transparent !important; }
.script-title, .script-result-title, .script-section-title, .script-closing { color: #26342b !important; }
.script-lede, .script-result-prologue, .script-act-text { color: #4f6355 !important; }
