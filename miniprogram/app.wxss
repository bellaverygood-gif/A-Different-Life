.script-pillar-label, .script-dayun-age, .script-small-note, .script-chart-note, .script-note, .script-disclaimer, .script-choice-sub, .script-choice-note, .script-bottom, .script-dot { color: #839284 !important; }
.script-pillar-value, .script-dayun-gz { color: #8a6d75 !important; }
.script-choice { border-left-color: rgba(178, 111, 128, 0.42) !important; }
.script-calendar-item { color: #6f806f !important; }
.script-calendar-item.is-active { border-color: rgba(178, 111, 128, 0.5) !important; background: rgba(255, 201, 211, 0.3) !important; color: #8a4f5e !important; }
.script-radio { color: #4f6355 !important; }
.script-error { color: #a04f5f !important; }

/* legal */
.privacy-title, .privacy-heading, .agreement-title, .agreement-heading { color: #26342b !important; }
.privacy-lede, .privacy-text, .privacy-item text:last-child, .agreement-text { color: #4f6355 !important; }
.privacy-updated, .privacy-foot, .agreement-updated, .agreement-foot { color: #839284 !important; }
.privacy-index, .privacy-item text:first-child, .privacy-agreement, .agreement-index { color: #8a6d75 !important; }
.privacy-hero, .privacy-section, .privacy-item, .agreement-hero, .agreement-section { border-color: rgba(56, 83, 66, 0.12) !important; }

/* spacing and surfaces */
.m1-hero-img { opacity: 0.3 !important; }
.life-setup, .script-setup {
  margin: 20rpx 24rpx 0;
  padding: 56rpx 30rpx 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7) !important;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.34) !important;
  box-shadow: 0 24rpx 64rpx rgba(66, 92, 74, 0.1), inset 0 1rpx 0 rgba(255, 255, 255, 0.78) !important;
  backdrop-filter: blur(22rpx) saturate(1.04);
}
.life-setup { min-height: auto !important; }
.script-form { margin-top: 36rpx; }
.life-result-hero, .script-result-hero { padding-top: 56rpx; }
.privacy-shell, .agreement-shell { padding-top: 10rpx; }
.privacy-hero, .agreement-hero {
  margin-top: 20rpx;
  padding: 36rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.32);
