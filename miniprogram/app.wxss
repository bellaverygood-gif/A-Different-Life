  background-color: #f7f4ed !important;
  background-image:
    radial-gradient(circle at 8% 4%, rgba(147, 172, 216, 0.58), transparent 36%),
    radial-gradient(circle at 94% 14%, rgba(147, 172, 216, 0.34), transparent 38%),
