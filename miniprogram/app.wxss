page {
  min-height: 100%;
  background-color: #050811;
  background-image:
    radial-gradient(circle at 12% 6%, rgba(81, 106, 154, 0.15), transparent 26%),
    radial-gradient(circle at 88% 18%, rgba(126, 91, 52, 0.12), transparent 24%),
    radial-gradient(circle at 48% 96%, rgba(55, 81, 127, 0.12), transparent 34%);
  color: #f1ece2;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

view, text, image, button, input, textarea, picker, scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
}

button::after {
  border: 0;
}

.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.shell {
  position: relative;
  z-index: 2;
  padding: 0 32rpx;
}

.serif {
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
}

.eyebrow {
  color: #8d877c;
  font-size: 18rpx;
  letter-spacing: 5rpx;
  line-height: 1.6;
}

.muted {
  color: #7f8796;
}

.gold {
  color: #dfc38e;
}

.divider {
  height: 1rpx;
  background: rgba(201, 207, 222, 0.11);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #e7cd9c, #cda76d);
  color: #17120c;
  box-shadow: 0 16rpx 40rpx rgba(205, 167, 109, 0.18);
}

.btn-ghost {
  border: 1rpx solid rgba(216, 204, 181, 0.24);
  background: rgba(255, 255, 255, 0.025);
  color: #d6cfc1;
}

.btn-quiet {
  min-height: 58rpx;
  padding: 0;
  color: #a99b84;
  font-size: 22rpx;
}

.btn-small {
  min-height: 66rpx;
  padding: 0 24rpx;
  font-size: 23rpx;
}

.card {
  border: 1rpx solid rgba(197, 204, 220, 0.13);
  border-radius: 28rpx;
  background: linear-gradient(155deg, rgba(18, 24, 38, 0.88), rgba(7, 11, 20, 0.94));
}

.spacer-8 { height: 8rpx; }
.spacer-12 { height: 12rpx; }
.spacer-16 { height: 16rpx; }
.spacer-24 { height: 24rpx; }
.spacer-32 { height: 32rpx; }
.spacer-48 { height: 48rpx; }

.hero-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.52;
}

.hero-shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(5, 8, 17, 0.2), rgba(5, 8, 17, 0.55) 45%, #050811 100%),
    linear-gradient(90deg, rgba(5, 8, 17, 0.9), transparent 70%);
}

.page-title {
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
  font-size: 64rpx;
  font-weight: 400;
  letter-spacing: -1rpx;
  line-height: 1.24;
}

.page-lede {
  margin-top: 20rpx;
  color: #969b9f;
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
  font-size: 28rpx;
  line-height: 1.9;
}

.field {
  margin-top: 30rpx;
}

.field-label {
  display: block;
  margin-bottom: 13rpx;
  color: #bbb3a5;
  font-size: 23rpx;
}

.field-label .optional {
  margin-left: 10rpx;
  color: #686f7d;
  font-size: 18rpx;
}

.input,
.textarea,
.picker-input {
  width: 100%;
  min-height: 84rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(195, 202, 219, 0.15);
  border-radius: 16rpx;
  background: rgba(8, 12, 21, 0.72);
  color: #e7e2d8;
  font-size: 27rpx;
  line-height: 1.6;
}

.textarea {
  min-height: 150rpx;
}

.picker-input {
  display: flex;
  align-items: center;
  color: #e7e2d8;
}

.picker-input.is-empty {
  color: #646d7c;
}

.field-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.field-grid .field {
  width: calc(50% - 9rpx);
}

.field-actions {
  margin-top: 28rpx;
}

.error-line {
  margin-top: 12rpx;
  color: #d8958c;
  font-size: 21rpx;
  line-height: 1.6;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.chip {
  max-width: 100%;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(195, 202, 219, 0.13);
  border-radius: 999rpx;
  color: #8d95a4;
  font-size: 19rpx;
  line-height: 1.4;
  word-break: break-all;
}

.chip b {
  margin-right: 8rpx;
  color: #746b5e;
  font-weight: 400;
}

.fade-in {
  animation: fadeIn 0.5s ease both;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(14rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.modal-mask {
  position: fixed;
  z-index: 80;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(2, 5, 12, 0.72);
}

.modal-panel {
  width: 100%;
  max-height: 82vh;
  padding: 34rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border: 1rpx solid rgba(205, 210, 222, 0.16);
  border-width: 1rpx 0 0;
  border-radius: 34rpx 34rpx 0 0;
  background: linear-gradient(155deg, #111725, #070b15 68%);
}

.modal-title {
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
  font-size: 42rpx;
  font-weight: 400;
  line-height: 1.4;
}

.modal-copy {
  margin-top: 13rpx;
  color: #858d9a;
  font-size: 24rpx;
  line-height: 1.8;
}

.modal-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 26rpx;
}

.modal-actions .btn {
  flex: 1;
}

.empty-state {
  padding: 48rpx 28rpx;
  border: 1rpx dashed rgba(195, 202, 219, 0.14);
  border-radius: 24rpx;
  color: #7e8796;
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
  font-size: 25rpx;
  line-height: 1.8;
  text-align: center;
}

.tap-dim {
  opacity: 0.68;
}

/* ── four type sizes only: 56 / 44 / 26 / 20 ── */
.m1-hero-caption, .life-name, .life-setup-title, .script-title, .script-result-title,
.privacy-title, .agreement-title, .page-title { font-size: 56rpx !important; }
.m1-mode-title, .life-section-title, .script-section-title, .privacy-heading, .agreement-heading,
.life-landing-text, .script-pillar-value { font-size: 44rpx !important; }
.m1-hero-sub, .m1-mode-desc, .m1-primary-btn, .life-setup-copy, .life-one-line, .life-fragment-text,
.life-skeleton-value, .life-note-v, .life-history-name, .script-lede, .script-result-prologue,
.script-act-text, .script-closing, .script-choice, .script-choice-input, .privacy-lede, .privacy-text,
.agreement-text, .life-emotion-btn, .life-card-btn, .script-picker, .script-input, .btn, .input, .textarea,
.brand-cn, .nav-back, .script-radio { font-size: 26rpx !important; }
.m1-mode-num, .m1-mode-tag, .m1-mode-sample, .m1-mode-reason, .m1-mode-arrow,
.eyebrow, .m1-note, .m1-foot, .m1-foot-links, .life-last, .life-note-k, .life-skeleton-label,
.life-disclaimer, .life-history-meta, .life-history-emotion, .life-emotion-note, .life-time-age,
.life-time-change, .life-bottom, .script-label, .script-optional, .script-unknown, .script-note,
.script-disclaimer, .script-chart-note, .script-small-note, .script-choice-note, .script-choice-sub,
.script-bottom, .privacy-index, .privacy-updated, .privacy-item text:first-child, .privacy-foot,
.privacy-agreement, .agreement-index, .agreement-updated, .agreement-foot, .error-line, .chip,
.script-calendar-item, .script-element { font-size: 20rpx !important; }
