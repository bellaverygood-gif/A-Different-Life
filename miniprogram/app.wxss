  font-size: 26rpx !important;
}

/* home banner: logo + one idea, no frame */
.m1-banner {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin: 18rpx 24rpx 0;
  padding: 38rpx 32rpx;
  border: 1rpx solid rgba(147, 172, 216, 0.42);
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 0% 0%, rgba(147, 172, 216, 0.38), transparent 54%),
