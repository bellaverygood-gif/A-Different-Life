  height: 430rpx !important;
  background:
    radial-gradient(circle at 12% 18%, rgba(185, 223, 194, 0.92), transparent 42%),
    radial-gradient(circle at 88% 12%, rgba(255, 201, 210, 0.88), transparent 44%),
    radial-gradient(circle at 70% 86%, rgba(255, 230, 216, 0.9), transparent 46%),
