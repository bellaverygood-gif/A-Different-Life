<view class="page predict-page">
  <nav-bar title="推演人生" />

  <block wx:if="{{view === 'setup'}}">
    <view class="predict-hero">
      <image class="predict-hero-img" src="/assets/mode-predict.jpg" mode="aspectFill" />
      <view class="predict-hero-shade"></view>
      <view class="predict-hero-copy shell">
        <text class="eyebrow">八字排盘 · 妻财子禄寿</text>
        <view class="predict-hero-title serif">
          <text>先看清这一生的底牌，</text>
          <text class="gold">再看另一个你如何走。</text>
        </view>
        <text class="predict-hero-lede">输入出生日期、时间、出生地与性别。我们会排出四柱，读出妻、财、子、禄、寿五个维度。想改写哪一步，等看完命盘再决定。</text>
        <view class="pillar-preview">
          <view wx:for="{{pillarPlaceholders}}" wx:key="*this" class="pillar-preview-item">
            <text class="pillar-preview-label">{{item}}</text>
            <text class="pillar-preview-value">?</text>
          </view>
        </view>
        <view class="setup-tags">
          <text>四柱命盘</text>
          <text>妻财子禄寿</text>
          <text>问题回检</text>
        </view>
      </view>
    </view>

    <view class="form-shell shell">
      <view class="form-card">
        <text class="eyebrow">你的出生信息</text>
        <text class="form-title serif">先把这一生的底牌排出来</text>
        <text class="form-lede">出生信息用于按北京时间与节气排出四柱，未做真太阳时校正。问题和来路可以选填；想改写哪一步，等看完妻财子禄寿之后再决定。</text>

        <view class="form-subhead">
          <text>出生信息</text>
          <text>用于排出年、月、日、时四柱</text>
        </view>

        <view class="field-grid">
          <view class="field">
            <text class="field-label">出生日期 <text class="required">必填</text></text>
            <picker mode="date" value="{{birthDate || '1995-01-01'}}" start="1940-01-01" end="2012-12-31" bindchange="onBirthDate">
              <view class="picker-input {{birthDate ? '' : 'is-empty'}}">{{birthDate || '请选择日期'}}</view>
            </picker>
          </view>
          <view class="field">
            <text class="field-label">出生时间 <text class="required">必填</text></text>
            <picker mode="time" value="{{birthTime || '12:00'}}" bindchange="onBirthTime">
              <view class="picker-input {{birthTime ? '' : 'is-empty'}}">{{birthTime || '请选择时间'}}</view>
            </picker>
          </view>
          <view class="field">
            <text class="field-label">出生地 <text class="required">必填</text></text>
            <input class="input" value="{{birthPlace}}" maxlength="40" placeholder="例如：杭州" placeholder-class="placeholder" bindinput="onBirthPlaceInput" />
          </view>
          <view class="field">
            <text class="field-label">性别 <text class="required">必填</text></text>
            <view class="gender-row">
              <view
                wx:for="{{genders}}"
                wx:key="id"
                class="gender-pill {{gender === item.id ? 'is-active' : ''}}"
                data-id="{{item.id}}"
                bindtap="selectGender"
              >{{item.label}}</view>
            </view>
          </view>
        </view>

        <view class="field">
          <text class="field-label">你想顺带推演的问题 <text class="optional">选填</text></text>
          <textarea class="textarea" value="{{question}}" maxlength="160" placeholder="例如：要不要离开现在的城市，去另一个地方重新开始？" placeholder-class="placeholder" bindinput="onQuestionInput" />
        </view>

        <view class="field">
          <text class="field-label">你写下的来路 <text class="optional">选填 · 用于回看问题</text></text>
          <textarea class="textarea" value="{{facts}}" maxlength="260" placeholder="例如：22 岁毕业留在家乡；27 岁进入现在的行业；31 岁放弃过一次晋升机会。" placeholder-class="placeholder" bindinput="onFactsInput" />
        </view>

        <text wx:if="{{error}}" class="error-line">{{error}}</text>

        <view class="generate-row">
          <view class="btn btn-primary generate-btn" bindtap="generatePrediction">排出命盘，先看这一生 <text>→</text></view>
          <text class="generate-note">先看命盘，再决定要不要改写。</text>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{view === 'result' && prediction}}">
    <view class="report-hero predict-report-hero">
      <image class="report-hero-img" src="/assets/mode-predict.jpg" mode="aspectFill" />
      <view class="report-hero-shade"></view>
      <view class="report-hero-copy shell">
        <text class="eyebrow">八字排盘 · 妻财子禄寿</text>
        <text class="report-title serif">{{prediction.name}}的命盘</text>
        <text class="birth-line">{{prediction.birthSummary}} · 日主 {{prediction.dayMasterLabel}}</text>
        <view class="pillar-row">
          <view wx:for="{{prediction.bazi.pillars}}" wx:key="label" class="pillar-card">
            <text class="pillar-label">{{item.label}}</text>
            <text class="pillar-value serif">{{item.value}}</text>
          </view>
        </view>
        <view class="report-meta">
          <text>{{prediction.metaTitle}}</text>
          <text>{{prediction.metaTurn}}</text>
          <text>{{prediction.genderLabel}}</text>
        </view>
        <view wx:if="{{prediction.hasNode}}" class="report-actions">
          <view class="btn btn-ghost btn-small" bindtap="openNodeModal">修改关键节点</view>
        </view>
      </view>
    </view>

    <view class="report-content shell">
      <view class="bazi-card">
        <view class="bazi-card-head">
          <view>
            <text class="eyebrow">你出生时带来的底牌</text>
            <text class="bazi-card-title serif">这一生的底牌</text>
          </view>
          <view class="element-chips">
            <view wx:for="{{prediction.bazi.elementChips}}" wx:key="key" class="element-chip {{item.className}}">
              <text>{{item.label}}</text>
              <text>{{item.count}}</text>
            </view>
          </view>
        </view>
        <text class="bazi-summary">{{prediction.bazi.elementLine}}</text>
        <text class="bazi-gender-note">{{prediction.genderNote}}</text>
        <view class="bazi-daymaster">
          <text class="bazi-daymaster-label">日主</text>
          <text class="bazi-daymaster-value serif">{{prediction.dayMasterLabel}}</text>
          <text class="bazi-daymaster-meta">{{prediction.bazi.metaLine}}</text>
        </view>
      </view>

      <view class="five-section">
        <view class="section-heading no-border">
          <view>
            <text class="eyebrow">五个维度</text>
            <text class="section-title serif">妻 · 财 · 子 · 禄 · 寿</text>
          </view>
          <text class="section-side-note">同一副命盘在五个人生侧面上的回声。</text>
        </view>
        <view class="five-list">
          <view wx:for="{{prediction.fiveReadings}}" wx:key="key" class="five-card">
            <text class="five-mark serif">{{item.mark}}</text>
            <view class="five-copy">
              <text class="five-label">0{{index + 1}} / {{item.title}}</text>
              <text class="five-text">{{item.text}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{prediction.questionProvided}}" class="question-check">
        <view class="check-head">
          <view>
            <text class="eyebrow">再看一遍</text>
            <text class="section-title serif">把这个问题放回命盘里看</text>
          </view>
          <text class="check-chip">你带来的问题</text>
        </view>
        <view class="check-question">“{{prediction.question}}”</view>
        <view class="check-panel">
          <text class="check-panel-label">命盘里与它最相关 · {{prediction.questionCheck.focus}}</text>
          <text class="check-panel-text">{{prediction.questionCheck.echo}}</text>
        </view>
        <view class="check-panel is-script">
          <text class="check-panel-label">放回这条时间线看</text>
          <text class="check-panel-text">{{prediction.questionCheck.scriptLine}}</text>
          <text class="check-panel-reframe">{{prediction.questionCheck.reframe}}</text>
        </view>
        <view wx:if="{{prediction.factChips.length}}" class="check-facts">
          <text class="check-facts-label">你写下的来路</text>
          <view class="chip-row">
            <view wx:for="{{prediction.factChips}}" wx:key="*this" class="chip">{{item}}</view>
          </view>
        </view>
        <text class="check-note">这不是替你做决定的答案，只是一次把问题、命盘与来路放在一起的核对。</text>
      </view>

      <view wx:if="{{!prediction.hasNode}}" class="predict-invite">
        <text class="eyebrow">轮到你了</text>
        <text class="invite-title serif">{{prediction.inviteTitle}}</text>
        <text class="invite-copy">{{prediction.inviteCopy}}</text>
        <view class="btn btn-primary invite-btn" bindtap="openNodeModal">写下想改变的地方 <text>→</text></view>
        <text class="invite-note">不是撤回，也不是重来，只是看看另一条时间线。</text>
      </view>

      <block wx:if="{{prediction.hasNode}}">
        <view wx:if="{{prediction.previousNode}}" class="change-banner">
          <text class="change-mark">↗</text>
          <view>
            <text class="change-title">转弯点已改写</text>
            <text class="change-copy">从「{{prediction.previousNode}}」到「{{prediction.node}}」。下面的两条时间线已经同步更新。</text>
          </view>
        </view>

        <view class="node-card">
          <view>
            <text class="eyebrow">你选择的节点</text>
            <text class="node-title serif">你决定改写的地方</text>
            <text class="node-value">{{prediction.node}}。</text>
            <text class="node-meta">在 {{prediction.age}} 岁，这个动作把两条时间线分开。</text>
          </view>
          <view class="btn btn-quiet" bindtap="openNodeModal">换一个节点 ↗</view>
        </view>

        <view id="compare" class="compare-section">
          <view class="compare-intro">
            <text class="eyebrow">两条时间线</text>
            <text class="compare-title serif">同一个你，两条时间线</text>
            <text class="compare-lede">不是「好结果」与「坏结果」的对照，而是两种代价不同的生活。</text>
          </view>
          <view class="compare-head">
            <view class="compare-side">
              <text class="compare-side-label">沿着现在</text>
              <text class="compare-side-title serif">{{prediction.baselineTitle}}</text>
              <text class="compare-side-text">{{prediction.baselineIntro}}</text>
            </view>
            <view class="compare-side is-change">
              <text class="compare-side-label">改写节点</text>
              <text class="compare-side-title serif">{{prediction.turningTitle}}</text>
              <text class="compare-side-text">{{prediction.turningIntro}}</text>
            </view>
          </view>
          <view class="phase-list">
            <view wx:for="{{prediction.phases}}" wx:key="span" class="phase-row">
              <text class="phase-label">{{item.span}}</text>
              <view class="phase-cell"><text class="phase-tag">原</text><text>{{item.stay}}</text></view>
              <view class="phase-cell is-change"><text class="phase-tag">改</text><text>{{item.change}}</text></view>
            </view>
          </view>
        </view>

        <view class="shift-section">
          <view class="section-heading no-border">
            <view>
              <text class="eyebrow">改变了什么</text>
              <text class="section-title serif">会改变的地方</text>
            </view>
            <text class="section-side-note">只看与这次选择真正相关的四个侧面。</text>
          </view>
          <view class="shift-list">
            <view wx:for="{{prediction.dimensions}}" wx:key="name" class="shift-card">
              <view class="shift-head"><text>0{{index + 1}}</text><text class="shift-name">{{item.name}}</text></view>
              <view class="shift-pair">
                <view class="shift-cell"><text class="shift-tag">原</text><text>{{item.stay}}</text></view>
                <view class="shift-cell is-change"><text class="shift-tag">改</text><text>{{item.change}}</text></view>
              </view>
            </view>
          </view>
        </view>

        <view class="odds-section">
          <view class="odds-column">
            <text class="eyebrow">机会</text>
            <text class="odds-title serif">可能打开的门</text>
            <view wx:for="{{prediction.opportunities}}" wx:key="*this" class="odds-item"><text>0{{index + 1}}</text><text>{{item}}</text></view>
          </view>
          <view class="odds-column is-cost">
            <text class="eyebrow">代价</text>
            <text class="odds-title serif">需要付的代价</text>
            <view wx:for="{{prediction.costs}}" wx:key="*this" class="odds-item"><text>0{{index + 1}}</text><text>{{item}}</text></view>
          </view>
        </view>

        <view class="insight-card">
          <text class="insight-mark">✦</text>
          <text class="eyebrow">最后一件事</text>
          <text class="insight-title serif">推演到这里，真正要问的是</text>
          <text class="insight-copy">{{prediction.insight}}</text>
        </view>
      </block>

      <view class="report-end-actions">
        <view class="btn btn-ghost btn-small" bindtap="newPrediction">换一个问题推演</view>
        <view wx:if="{{prediction.hasNode}}" class="btn btn-primary btn-small" bindtap="openNodeModal">再改一次节点</view>
      </view>
      <view class="quiet-link" bindtap="goHome">回到首页</view>
      <text class="report-disclaimer">四柱按北京时间与节气交节时刻排盘，未做真太阳时校正；内容为虚构叙事，不构成命理、职业、财务、医疗或关系建议。</text>
    </view>
  </block>

  <view wx:if="{{showNodeModal}}" class="modal-mask" catchtap="closeNodeModal" catchtouchmove="stopBubble">
    <view class="modal-panel" catchtap="stopBubble">
      <text class="eyebrow">移动转折点</text>
      <text class="modal-title serif">{{prediction.hasNode ? '如果改在另一个节点' : '如果给你一次改写的机会'}}</text>
      <text class="modal-copy">写下一个你想改写的关键节点，最好与当前问题在同一方向。可以带上年龄，例如「31 岁，接受外地晋升」。</text>
      <view class="field">
        <textarea class="textarea" value="{{nodeDraft}}" maxlength="120" placeholder="例如：31 岁，接受外地晋升。" placeholder-class="placeholder" bindinput="onNodeInput" />
      </view>
      <text wx:if="{{nodeError}}" class="error-line">{{nodeError}}</text>
      <view class="modal-actions">
        <view class="btn btn-ghost btn-small" bindtap="closeNodeModal">取消</view>
        <view class="btn btn-primary btn-small" bindtap="confirmNode">重新推演</view>
      </view>
    </view>
  </view>

  <loading-mask show="{{loading}}" text="{{loadingText}}" sub="{{loadingSub}}" />
</view>
